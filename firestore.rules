rules_version = '2';

// The browser never talks to Firestore directly — every read and write goes
// through /api, which authenticates the session itself and uses the Admin
// SDK. Admin SDK access bypasses these rules entirely, so denying everything
// here closes off direct client access without affecting the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
